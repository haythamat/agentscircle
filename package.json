{
  "name": "agentscircle",
  "version": "1.3.13",
  "description": "One chat for all your AI coding agents: @mention Claude Code, Codex, Cursor and OpenCode in one shared session.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "app": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "tools:keygen": "node scripts/keygen.js",
    "tools:sign": "node scripts/sign-tools.js",
    "postinstall": "node scripts/fix-pty.js"
  },
  "license": "FSL-1.1-ALv2",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.1",
    "cross-spawn": "^7.0.6",
    "docx": "^9.15.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "marked": "^15.0.12",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "AgentsCircle",
  "author": {
    "name": "AgentsCircle"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haythamat/agentscircle"
  },
  "agentscircle": {
    "toolsUrl": "",
    "toolsPublicKey": "",
    "_readme": "toolsUrl: raw URL of tools.json in your repo (e.g. https://raw.githubusercontent.com/haythamat/agentscircle/main/tools.json). toolsPublicKey: printed by npm run tools:keygen. Leave empty to turn signed agent-settings fixes off.",
    "usageUrl": "https://agentscircle.dev/api/public/usage"
  },
  "build": {
    "appId": "dev.agentscircle.desktop",
    "productName": "AgentsCircle",
    "copyright": "Copyright © 2026 AgentsCircle",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "tools.json",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "src/circle-mcp.js",
      "src/mock-agent.js",
      "node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "AgentsCircle ${version}",
      "artifactName": "${productName}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AgentsCircle",
      "artifactName": "${productName}-Setup-Windows.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "appImage": {
      "artifactName": "${productName}-Linux.${ext}"
    },
    "npmRebuild": false
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
